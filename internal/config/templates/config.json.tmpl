{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "vless-reality",
      "port": {{ .Port }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": {{ q .UUID }},
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": {{ q (printf "%s:443" .DestHost) }},
          "xver": 0,
          "serverNames": [{{ q .DestHost }}],
          "privateKey": {{ q .PrivateKey }},
          "shortIds": [{{ q .ShortID }}]
        }
      }
    },
    {
      "tag": "hysteria2",
      "port": {{ .Port }},
      "protocol": "hysteria",
      "settings": {
        "version": 2,
        "users": [{"auth": {{ q .Hysteria.Password }}}]
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "alpn": ["h3"],
          "certificates": [
            {
              "certificate": [{{ q .Hysteria.Certificate }}],
              "key": [{{ q .Hysteria.Key }}]
            }
          ]
        },
        "hysteriaSettings": {
          "version": 2
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
